# Copy to .env (or set these in your host's environment) before deploying.
# Anything without a default below will stop the app from starting if unset.

# ── Database ─────────────────────────────────────────────────────────────────
# Required. Point at a managed Postgres, not localhost, and make sure it has
# automated backups — this is where every section, item and upload record lives.
PROD_DB_URL=jdbc:postgresql://your-db-host:5432/ideias_midias
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# ── Security ─────────────────────────────────────────────────────────────────
# Required. At least 32 random bytes, base64 or hex. Generate one with:
#   openssl rand -base64 48
# Changing it logs every admin out. Never reuse the value from another install.
APP_JWT_SECRET=

# Required. Comma-separated origins allowed to call this API — the exact scheme
# and host of your frontend, no trailing slash. A wrong value here shows up as
# CORS errors in the browser, not as a server error.
APP_CORS_ALLOWED_ORIGINS=https://your-site.com

# How the refresh cookie is scoped.
#   None → frontend and API on different domains (admin.site.com + api.site.com)
#   Lax  → same domain (site.com and site.com/api). Safer; prefer it when you can.
# None also requires HTTPS, which is already enforced below.
APP_JWT_REFRESH_COOKIE_SAME_SITE=None

# Leave true. The refresh cookie will not be sent over plain HTTP, so admin
# login simply will not work without TLS.
APP_JWT_REFRESH_COOKIE_SECURE=true

# Keep "framework" when anything terminates TLS in front of this app — Nginx,
# a cloud load balancer, Railway, Render, Cloudflare. Only "none" if the JVM
# itself is the thing holding the certificate.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ── First admin ──────────────────────────────────────────────────────────────
# Turn on for the very first boot to create one account, then set it back to
# false and redeploy. Leaving it enabled recreates the same known login.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# ── Uploads ──────────────────────────────────────────────────────────────────
# "local" writes to the container's disk, which is wiped on every redeploy and
# is not shared between instances — uploaded images and video will disappear.
# Use "r2" for anything real.
APP_STORAGE_PROVIDER=r2
APP_STORAGE_R2_ACCOUNT_ID=
APP_STORAGE_R2_ACCESS_KEY_ID=
APP_STORAGE_R2_SECRET_ACCESS_KEY=
APP_STORAGE_R2_BUCKET=
# Public URL the bucket is served from, e.g. https://media.your-site.com
APP_STORAGE_R2_PUBLIC_BASE_URL=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Seconds a public GET may be reused by browsers, proxies and the frontend's
# fetch cache. 0 turns caching off.
APP_CACHE_PUBLIC_MAX_AGE_SECONDS=60

# The same visitor reopening the same page inside this window counts once.
APP_ANALYTICS_DEDUPE_WINDOW_MINUTES=30

# Longest side of a delivered video. Phone clips are often 4K, which nobody on
# a slow connection can stream. 0 keeps the original size.
APP_MEDIA_VIDEO_MAX_LONG_SIDE=1280

# Raise as traffic grows, and check your database plan allows this many.
DB_POOL_MAX_SIZE=20
